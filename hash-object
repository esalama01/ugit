import(
	"os"
	//"log"
	"compress/zlib"
	"strings"
	"os/exec"
	"crypto/sha1"
)

func check(e error) {
    if e != nil {
        panic(e)
    }
}

type Objects interface {
	Get_Hash()	string

}

func Header(file *os.File) string{//must return a "_blob__space_size of the contents of the file in bytes_\0_"
	//i'll be using the exec.Command() function
	file_name := file.Name()
	cmd := exec.Command("wc", "-c", file_name)
	size, err := cmd.Output()
	check(err)
	s1 := "blob"
	s2 := "%d,size"
	s3 := '\0'
	result := s1 + " " + s2 + s3 //string concatenation
	return result
}

func Sha1(file *os.File) [32]byte{
	header := Header(file)
	data := []byte(header)
	return sha1.Sum(data)
}

func compression(file *os.File) {
	data, err := os.ReadFile(file)
	check(err)
	var b bytes.Buffer
	w := zlib.NewWriter(&b)
	w.Write([]byte(data))
	w.Close()
	return b.Bytes()
}

func (b Blob)Get_Hash(f *os.File){
	id := strings.Trimspace(Sha1(f))
	b.Blob_ID = id
	
}